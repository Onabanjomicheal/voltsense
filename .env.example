# Copy this file to .env and fill in real values. Never commit the real .env file.

# DagsHub -- used for both the DVC remote (data/model versioning) and MLflow
# tracking server. Get your token from https://dagshub.com/user/settings/tokens
DAGSHUB_TOKEN=your_dagshub_token_here
MLFLOW_TRACKING_URI=https://dagshub.com/<your-username>/<your-repo>.mlflow

# Render deploy hooks -- found in each service's Settings -> Deploy Hook, after
# creating the staging and production services from render-staging.yaml /
# render-production.yaml.
RENDER_STAGING_DEPLOY_HOOK_URL=https://api.render.com/deploy/srv-xxxxx?key=xxxxx
RENDER_PRODUCTION_DEPLOY_HOOK_URL=https://api.render.com/deploy/srv-yyyyy?key=yyyyy

# The live URLs of each deployed service, used by CI to verify health after deploy.
STAGING_URL=https://battery-soc-api-staging.onrender.com
PRODUCTION_URL=https://battery-soc-api-production.onrender.com

# These three (DAGSHUB_TOKEN, RENDER_*_DEPLOY_HOOK_URL, STAGING_URL, PRODUCTION_URL)
# must also be added as GitHub Actions secrets in:
# repo Settings -> Secrets and variables -> Actions -> New repository secret
